{
  "name": "jockey-sim",
  "version": "1.0.0",
  "private": true,
  "description": "蹄音 -ジョッキーの判断- 開発用スクリプト（ゲーム本体 jockey_game.html はゼロ依存の単一HTML）",
  "type": "commonjs",
  "scripts": {
    "balance": "node sims/balance_check.js",
    "stamina": "node sims/stamina_tune.js",
    "smoke": "node sims/smoke.js",
    "grid": "node sims/grid_search.js",
    "gates": "node sims/balance_check.js 400 && node sims/smoke.js",
    "bundle": "esbuild src/three-bootstrap.js --bundle --minify --format=esm --outfile=vendor/three-bundle.js",
    "build": "node build.js",
    "icons": "node tools/make-icons.js",
    "serve": "node tools/serve.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "three": "^0.160.0"
  }
}
